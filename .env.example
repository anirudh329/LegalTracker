# Postgres connection string. Vercel's Postgres (Neon) integration sets
# POSTGRES_URL automatically; a plain Neon project or any other Postgres
# uses DATABASE_URL. Either name works — set whichever your provider gives you.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Shared password required to save changes (view access needs no password).
EDIT_PASSWORD=choose-a-password

# Random string used to sign the edit-session cookie. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string
